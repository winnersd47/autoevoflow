# =============================================================================
# Frontend – Multi-stage Node.js Dockerfile (Next.js)
# Stage 1 (deps):     install production + dev node_modules
# Stage 2 (builder):  next build → standalone output
# Stage 3 (development): hot-reload with bind mount
# Stage 4 (production):  minimal Alpine runtime, non-root user
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: deps – install all dependencies (cache this layer separately)
# ---------------------------------------------------------------------------
FROM node:20-alpine AS deps

# Required to build native addons (sharp, canvas, etc.)
RUN apk add --no-cache libc6-compat python3 make g++

WORKDIR /app

# Copy only package manifests first for maximum layer-cache efficiency
COPY frontend/package.json frontend/package-lock.json* ./

# Install both production and dev dependencies (needed for next build)
RUN npm ci --frozen-lockfile

# ---------------------------------------------------------------------------
# Stage 2: builder – produce the Next.js standalone build
# ---------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Bring in installed modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy full source; .dockerignore should exclude .git, node_modules, .next
COPY frontend/ ./

# Configure Next.js for standalone output (required for Stage 4)
# This is set in next.config.js: output: 'standalone'
# The build bakes in NEXT_PUBLIC_* env vars – override at build time as needed.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NODE_ENV=production \
    # Disable Next.js telemetry in CI/build
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ---------------------------------------------------------------------------
# Stage 3: development – source bind-mounted, hot-reload via `npm run dev`
# ---------------------------------------------------------------------------
FROM node:20-alpine AS development

RUN apk add --no-cache libc6-compat curl

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules

# Source will be bind-mounted; we only need the compiled node_modules here.
EXPOSE 3200

ENV NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3200

CMD ["npm", "run", "dev"]

# ---------------------------------------------------------------------------
# Stage 4: production – standalone output, minimal footprint
# ---------------------------------------------------------------------------
FROM node:20-alpine AS production

RUN apk add --no-cache curl

# Non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3200

# Next.js standalone build includes only the files needed to run the server.
# Static assets and public directory must be copied separately.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static    ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public          ./public

USER nextjs

EXPOSE 3200

# server.js is generated by Next.js standalone build
CMD ["node", "server.js"]
