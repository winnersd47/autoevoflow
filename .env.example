# =============================================================================
# .env.example – automotive-ai-platform
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# =============================================================================
# Core environment
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug

# =============================================================================
# Backend application
# =============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_RELOAD=true

# Secret key for JWT signing – generate with: openssl rand -base64 64
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# =============================================================================
# PostgreSQL (with pgvector)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=automotive_ai
POSTGRES_USER=automotive_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Async SQLAlchemy DSN (auto-built from above, or override directly)
DATABASE_URL=postgresql+asyncpg://automotive_user:CHANGE_ME_strong_password_here@localhost:5432/automotive_ai

# Connection pool
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_TIMEOUT=30

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:6379/0
REDIS_MAX_CONN=50
CACHE_TTL_SECS=3600

# =============================================================================
# Neo4j
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password
NEO4J_DATABASE=neo4j

# =============================================================================
# MinIO (S3-compatible object storage)
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_SECURE=false
MINIO_BUCKET_IMAGES=vehicle-images
MINIO_BUCKET_MODELS=ml-models
MINIO_BUCKET_EXPORTS=data-exports

# AWS (if using real S3 instead of MinIO)
AWS_ACCESS_KEY_ID=CHANGE_ME_aws_access_key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=automotive-ai-prod

# =============================================================================
# External AI APIs
# =============================================================================
OPENAI_API_KEY=sk-CHANGE_ME_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Optional (paid): Anthropic Claude — used for highest-quality single-source analysis
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME_anthropic_api_key
ANTHROPIC_MODEL=claude-opus-4-5

# =============================================================================
# Free AI — Dual-Variant Analysis (Analytical + Historical perspectives)
# =============================================================================

# Groq (FREE) — Analytical perspective: Llama 3.1 70B
# 14,400 requests/day free. Get key: console.groq.com
GROQ_API_KEY=gsk_CHANGE_ME_groq_api_key
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_FALLBACK_MODEL=mixtral-8x7b-32768

# Google Gemini Flash (FREE) — Historical perspective
# 1,500 requests/day free. Get key: aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=CHANGE_ME_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# AI analysis strategy: "dual" (Groq+Gemini), "groq", "gemini", "anthropic"
AI_ANALYSIS_STRATEGY=dual

# =============================================================================
# ML Inference service
# =============================================================================
ML_INFERENCE_PORT=8001
ML_INFERENCE_URL=http://localhost:8001

# Model configuration
CLIP_MODEL=ViT-L-14
CLIP_PRETRAINED=openai
DINO_MODEL=facebook/dinov2-large
BATCH_SIZE=16
DEVICE=cpu
# Use DEVICE=cuda on GPU machines. Requires CUDA 11.8+.

MODELS_DIR=./models
EMBEDDING_DIM=1536
MAX_IMAGE_SIZE=1024
ENABLE_HALF_PREC=false   # Set true on GPU for fp16 inference

ML_REQUEST_TIMEOUT=120
ML_RETRY_ATTEMPTS=3
ML_RETRY_DELAY_SECS=2

# =============================================================================
# Crawlers
# =============================================================================
CRAWLER_CONCURRENCY=2
CRAWLER_DELAY_MS=1500
CRAWLER_USER_AGENT=AutomotiveAI-Bot/1.0 (+https://yourdomain.com/bot)
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT_SECS=30

# Proxy (optional – for distributed crawling)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# =============================================================================
# Frontend
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3200
NEXT_PUBLIC_GA_ID=G-CHANGE_ME_GOOGLE_ANALYTICS_ID

# =============================================================================
# CORS & security
# =============================================================================
CORS_ORIGINS=http://localhost:3200,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# OAuth / Social auth
# =============================================================================
GOOGLE_CLIENT_ID=CHANGE_ME_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=CHANGE_ME_github_client_id
GITHUB_CLIENT_SECRET=CHANGE_ME_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# =============================================================================
# Email (SMTP)
# =============================================================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# Observability
# =============================================================================
METRICS_ENABLED=true
METRICS_PORT=8000
METRICS_PATH=/metrics

# Sentry error tracking
SENTRY_DSN=https://CHANGE_ME@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_RATE=0.1

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=automotive-ai-backend

# =============================================================================
# Docker Compose overrides
# =============================================================================
COMPOSE_PROJECT_NAME=automotive-ai
POSTGRES_DATA_DIR=./volumes/postgres
REDIS_DATA_DIR=./volumes/redis
NEO4J_DATA_DIR=./volumes/neo4j
MINIO_DATA_DIR=./volumes/minio
GRAFANA_DATA_DIR=./volumes/grafana
PROMETHEUS_DATA_DIR=./volumes/prometheus
