# ─────────────────────────────────────────────────────────────────────────────
# Automotive AI Evolution Platform — Environment Variables
# Copy this file to .env and fill in all required values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Automotive AI Evolution Platform"
APP_VERSION="1.0.0"
# Options: development | staging | production
ENVIRONMENT=development
DEBUG=false
# Long random secret for general application use (sessions, CSRF, etc.)
SECRET_KEY=your-super-secret-key-change-me-in-production

# ── PostgreSQL (with pgvector) ─────────────────────────────────────────────────
# Use asyncpg driver: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/automotive_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20
REDIS_DECODE_RESPONSES=true

# ── Neo4j (Graph Database) ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
# Models used for different tasks
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Used for vision-based comparisons (GPT-4o)
OPENAI_CHAT_MODEL=gpt-4o

# ── Anthropic (Claude) ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-4-5

# ── Vision / Embedding Models ──────────────────────────────────────────────────
# CLIP model for visual embeddings (open_clip)
CLIP_MODEL_NAME=ViT-L-14
# DINOv2 model for semantic embeddings (huggingface)
DINO_MODEL_NAME=facebook/dinov2-large
# Number of images to embed in a single batch
EMBEDDING_BATCH_SIZE=32
# Device for model inference: cpu | cuda | mps
MODEL_DEVICE=cpu

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Must be at least 32 random characters — keep this secret!
JWT_SECRET=your-jwt-secret-key-change-me-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
# Access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiry in days
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth2 ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── GitHub OAuth2 ──────────────────────────────────────────────────────────────
# Create OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ── AWS S3 / MinIO ─────────────────────────────────────────────────────────────
S3_BUCKET=automotive-ai-assets
AWS_ACCESS_KEY=your-aws-access-key-id
AWS_SECRET_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
# Set for MinIO or other S3-compatible endpoints; leave blank for AWS S3
S3_ENDPOINT_URL=

# ── Observability ──────────────────────────────────────────────────────────────
# Sentry DSN for error tracking — leave blank to disable
SENTRY_DSN=
# Fraction of transactions to trace (0.0–1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# OpenTelemetry collector endpoint — leave blank to disable
OTEL_ENDPOINT=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins in staging/production
ALLOWED_ORIGINS=http://localhost:3200,http://localhost:3001
ALLOWED_METHODS=*
ALLOWED_HEADERS=*

# ── Crawler Settings ───────────────────────────────────────────────────────────
# Maximum number of concurrent crawl workers
MAX_CRAWL_WORKERS=10
# Requests per second rate limit per source
CRAWL_RATE_LIMIT_RPS=2.0
# HTTP request timeout for crawler requests (seconds)
CRAWL_REQUEST_TIMEOUT=30

# ── Celery (Task Queue) ────────────────────────────────────────────────────────
# Use a separate Redis DB for broker and results to avoid key collisions
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# ── Pagination ─────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Vector Search ──────────────────────────────────────────────────────────────
# Default number of results to return from vector searches
VECTOR_SEARCH_LIMIT=20
# Minimum cosine similarity score (0.0–1.0) to include in results
VECTOR_SEARCH_MIN_SCORE=0.6

# ── Static Files (optional) ────────────────────────────────────────────────────
# Path to static files directory — leave blank to disable static file serving
STATIC_DIR=
